# Read at deploy time by Config.redacted/Config.string in src/worker.ts and
# bound onto the Worker as secret_text. Never commit real values.

# >= 32 chars. Rotating this re-derives every tenant key, which requires
# re-encrypting the vault — it is not a drop-in rotation.
VAULT_MASTER_KEY=

# The Playwright container used only when the SSO presents a captcha.
BROWSER_SERVICE_URL=https://browser.internal
BROWSER_SERVICE_TOKEN=
